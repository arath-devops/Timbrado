{
  "type": "record",
  "name": "UserCreated",
  "namespace": "mx.gov.erpgrp.events.mvp",
  "doc": "Kafka event UserCreated on topic core.iam.events produced by iam-service. eventVersion=1",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "UUID \u2014 consumer idempotency key"
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "eventTimestamp",
      "type": "string",
      "doc": "ISO-8601 UTC"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "UUID"
    },
    {
      "name": "correlationId",
      "type": "string",
      "doc": "UUID \u2014 E2E flow"
    },
    {
      "name": "causationId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "traceId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "requestId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "UserCreatedPayload",
        "namespace": "mx.gov.erpgrp.events.mvp",
        "fields": [
          {
            "name": "userId",
            "type": "string"
          },
          {
            "name": "username",
            "type": "string"
          },
          {
            "name": "email",
            "type": "string"
          },
          {
            "name": "displayName",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "status",
            "type": {
              "type": "enum",
              "name": "UserStatus",
              "symbols": [
                "ACTIVE",
                "LOCKED",
                "DISABLED"
              ]
            },
            "default": "ACTIVE"
          },
          {
            "name": "roleCodes",
            "type": {
              "type": "array",
              "items": "string"
            },
            "default": []
          }
        ]
      }
    }
  ]
}
