      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "eventTimestamp",
      "type": "string",
      "doc": "ISO-8601 UTC"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "UUID"
    },
    {
