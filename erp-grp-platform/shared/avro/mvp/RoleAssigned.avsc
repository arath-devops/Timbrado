      "type": "string",
      "doc": "UUID \u2014 E2E flow"
    },
    {
      "name": "causationId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "traceId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "requestId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
