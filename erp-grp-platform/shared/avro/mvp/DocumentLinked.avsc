{
  "type": "record",
  "name": "DocumentLinked",
  "namespace": "mx.gov.erpgrp.events.mvp",
  "doc": "Kafka event DocumentLinked on topic core.document.events produced by document-service. eventVersion=1",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "UUID \u2014 consumer idempotency key"
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "eventTimestamp",
      "type": "string",
      "doc": "ISO-8601 UTC"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "UUID"
    },
    {
      "name": "correlationId",
      "type": "string",
      "doc": "UUID \u2014 E2E flow"
    },
    {
      "name": "causationId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "traceId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "requestId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "DocumentLinkedPayload",
        "namespace": "mx.gov.erpgrp.events.mvp",
        "fields": [
          {
            "name": "documentId",
            "type": "string"
          },
          {
            "name": "linkId",
            "type": "string"
          },
          {
            "name": "boundedContext",
            "type": "string"
          },
          {
            "name": "aggregateType",
            "type": "string"
          },
          {
            "name": "aggregateId",
            "type": "string"
          },
          {
            "name": "relation",
            "type": {
              "type": "enum",
              "name": "DocRelation",
              "symbols": [
                "SUPPORTING",
                "PRIMARY",
                "ANNEX"
              ]
            },
            "default": "SUPPORTING"
          },
          {
            "name": "linkedBy",
            "type": "string"
          }
        ]
      }
    }
  ]
}
