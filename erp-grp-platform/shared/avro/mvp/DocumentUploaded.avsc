{
  "type": "record",
  "name": "DocumentUploaded",
  "namespace": "mx.gov.erpgrp.events.mvp",
  "doc": "Kafka event DocumentUploaded on topic core.document.events produced by document-service. eventVersion=1",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "UUID \u2014 consumer idempotency key"
    },
    {
      "name": "eventType",
      "type": "string"
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "eventTimestamp",
      "type": "string",
      "doc": "ISO-8601 UTC"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "UUID"
    },
    {
      "name": "correlationId",
      "type": "string",
      "doc": "UUID \u2014 E2E flow"
    },
    {
      "name": "causationId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "traceId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "requestId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "DocumentUploadedPayload",
        "namespace": "mx.gov.erpgrp.events.mvp",
        "fields": [
          {
            "name": "documentId",
            "type": "string"
          },
          {
            "name": "caseFileId",
            "type": "string"
          },
          {
            "name": "docType",
            "type": "string"
          },
          {
            "name": "contentType",
            "type": "string"
          },
          {
            "name": "sizeBytes",
            "type": "long"
          },
          {
            "name": "checksumSha256",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "uploadedBy",
            "type": "string"
          },
          {
            "name": "title",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    }
  ]
}
