{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp-grp.local/schemas/events/mvp/BudgetReleased.json",
  "title": "BudgetReleased",
  "description": "Kafka event BudgetReleased. Topic=grp.budget.events. Producer=budget-service. Version=1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "eventTimestamp",
    "tenantId",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "BudgetReleased"
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "const": "budget-service"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movementId",
        "allocationId",
        "amount",
        "currency",
        "referenceType",
        "referenceId"
      ],
      "properties": {
        "movementId": {
          "type": "string",
          "format": "uuid"
        },
        "allocationId": {
          "type": "string",
          "format": "uuid"
        },
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,4})?$"
        },
        "currency": {
          "type": "string",
          "enum": [
            "MXN"
          ]
        },
        "referenceType": {
          "type": "string",
          "enum": [
            "PURCHASE_ORDER",
            "PURCHASE_REQUISITION",
            "PURCHASE_REQUEST"
          ]
        },
        "referenceId": {
          "type": "string",
          "format": "uuid"
        },
        "releasedCommitMovementId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "availableAfter": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotencyKey": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  },
  "x-topic": "grp.budget.events",
  "x-producer": "budget-service",
  "x-event-version": 1
}
