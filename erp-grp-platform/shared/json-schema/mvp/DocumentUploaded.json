{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp-grp.local/schemas/events/mvp/DocumentUploaded.json",
  "title": "DocumentUploaded",
  "description": "Kafka event DocumentUploaded. Topic=core.document.events. Producer=document-service. Version=1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "eventTimestamp",
    "tenantId",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "DocumentUploaded"
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "const": "document-service"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "caseFileId",
        "docType",
        "contentType",
        "sizeBytes",
        "uploadedBy"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "caseFileId": {
          "type": "string",
          "format": "uuid"
        },
        "docType": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksumSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "uploadedBy": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "x-topic": "core.document.events",
  "x-producer": "document-service",
  "x-event-version": 1
}
