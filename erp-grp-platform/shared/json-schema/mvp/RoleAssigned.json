{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp-grp.local/schemas/events/mvp/RoleAssigned.json",
  "title": "RoleAssigned",
  "description": "Kafka event RoleAssigned. Topic=core.iam.events. Producer=iam-service. Version=1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "eventTimestamp",
    "tenantId",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "RoleAssigned"
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "const": "iam-service"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "roleCodes",
        "assignedBy"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "roleCodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "assignedBy": {
          "type": "string",
          "format": "uuid"
        },
        "previousRoleCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-topic": "core.iam.events",
  "x-producer": "iam-service",
  "x-event-version": 1
}
