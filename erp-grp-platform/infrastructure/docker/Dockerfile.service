# Generic multi-stage Dockerfile for MVP Spring Boot services (DoD-001)
# Usage:
#   docker build -f infrastructure/docker/Dockerfile.service \
#     --build-arg SERVICE=iam-service -t erpgrp/iam-service:local erp-grp-platform
ARG SERVICE=iam-service
FROM eclipse-temurin:21-jdk-jammy AS build
ARG SERVICE
WORKDIR /workspace
COPY backend /workspace
RUN apt-get update && apt-get install -y --no-install-recommends maven \
 && mvn -f /workspace/pom.xml -pl services/${SERVICE} -am -DskipTests package \
 && rm -rf /var/lib/apt/lists/*

FROM eclipse-temurin:21-jre-jammy
ARG SERVICE
RUN useradd -r -u 10001 appuser
WORKDIR /app
COPY --from=build /workspace/services/${SERVICE}/target/${SERVICE}-*.jar /app/app.jar
USER appuser
ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75"
EXPOSE 8080
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
